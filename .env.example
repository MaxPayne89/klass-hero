# Database Configuration
# Copy this file to .env and customize the values for your local development

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Override this checkout's dev database. Unset, the name is derived per checkout:
# klass_hero_dev on main, klass_hero_dev_<checkout> in a worktree.
# See .claude/rules/worktrees.md.
# LOCAL_DEV_DATABASE=klass_hero_dev

# Phoenix Application
SECRET_KEY_BASE=your-secret-key-base-here
PHX_SERVER=true
PORT=4000

# Development Environment
MIX_ENV=dev

# Compilation Performance (Elixir 1.19+)
# Compiles dependencies in parallel using separate OS processes.
# Recommended: half the number of CPU cores on your machine.
MIX_OS_DEPS_COMPILE_PARTITION_COUNT=4